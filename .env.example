# Copy file ini menjadi .env untuk local server.
# Jangan share .env ke orang lain. File .env sudah masuk .gitignore.

# AI utama
GEMINI_API_KEY=isi_api_key_gemini_kamu
AI_PROVIDER=gemini

# Supabase auto cloud profile
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=isi_anon_public_key_supabase

# Opsional fallback AI
# GROQ_API_KEY=isi_key_groq_kamu
# OPENROUTER_API_KEY=isi_key_openrouter_kamu

# Keamanan endpoint AI
# Default: true kalau SUPABASE_URL + SUPABASE_ANON_KEY terisi.
# Set false HANYA untuk pengembangan lokal tanpa akun.
# AI_REQUIRE_AUTH=true

# Batas permintaan AI per user/IP dalam 10 menit. Default 15.
# Catatan: penghitung ini in-memory, jadi tidak akurat di serverless
# multi-instance. Untuk batas yang benar-benar mengikat, pakai Redis.
# AI_RATE_LIMIT=15

# Anggaran waktu total satu request AI dalam milidetik. Default 25000.
# Harus lebih kecil dari maxDuration di vercel.json (30 detik).
# AI_TIME_BUDGET_MS=25000

# Opsional
PORT=4173
